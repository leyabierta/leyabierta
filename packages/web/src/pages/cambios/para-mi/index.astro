---
import AiNotice from "../../../components/AiNotice.astro";
import Base from "../../../layouts/Base.astro";
---

<Base
	title="Cambios para mí"
	description="Los cambios legislativos que afectan a tu situación personal, filtrados por tus temas y tu comunidad autónoma."
	ogTitle="Cambios para mí — Ley Abierta"
	canonicalUrl="/cambios/para-mi/"
>
	<style is:global>
		.cambios-wrap {
			max-width: 680px;
			margin: 0 auto;
			padding: 2rem 1rem 3.5rem;
		}
		#cambios-content {
			min-height: 24rem;
		}

		/* ── Header ── */
		.cambios-header {
			margin-bottom: 1.75rem;
		}
		.cambios-header h1 {
			font-family: var(--font-serif);
			font-size: 1.875rem;
			font-weight: 700;
			line-height: 1.15;
			color: var(--text);
			margin-bottom: 0.75rem;
			letter-spacing: -0.02em;
		}
		.cambios-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			align-items: center;
			margin-bottom: 0.5rem;
		}
		.situation-tag {
			display: inline-block;
			font-size: 0.75rem;
			font-weight: 500;
			padding: 0.1875rem 0.625rem;
			border-radius: 6px;
			background: var(--accent-bg);
			color: var(--accent);
			white-space: nowrap;
		}
		.cambios-info {
			font-size: 0.8125rem;
			color: var(--text-muted);
			display: flex;
			gap: 0.5rem;
			align-items: center;
			flex-wrap: wrap;
		}
		.cambios-info a {
			color: var(--accent);
			text-decoration: underline;
		}

		/* ── Loading skeleton ── */
		.skeleton-cards {
			display: flex;
			flex-direction: column;
			gap: 0.875rem;
		}
		.skeleton-card {
			background: var(--surface);
			border: 1px solid var(--border-light);
			border-radius: 12px;
			padding: 1.125rem 1.25rem;
		}
		.skeleton-line {
			height: 0.875rem;
			background: var(--border-light);
			border-radius: 4px;
			margin-bottom: 0.625rem;
			animation: pulse 1.5s ease-in-out infinite;
		}
		.skeleton-line:nth-child(2) { width: 75%; }
		.skeleton-line:nth-child(3) { width: 60%; }
		@keyframes pulse {
			0%, 100% { opacity: 0.4; }
			50% { opacity: 1; }
		}

		/* ── Empty state ── */
		.empty-state {
			text-align: center;
			padding: 3rem 1.5rem;
			background: var(--surface);
			border: 1px solid var(--border-light);
			border-radius: 12px;
		}
		.empty-check {
			width: 56px;
			height: 56px;
			border-radius: 50%;
			background: var(--success-bg);
			color: var(--success);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-size: 1.5rem;
			margin-bottom: 1rem;
		}
		.empty-state h2 {
			font-family: var(--font-serif);
			font-size: 1.375rem;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.5rem;
		}
		.empty-state p {
			color: var(--text-muted);
			font-size: 0.9375rem;
			max-width: 24rem;
			margin: 0 auto;
			line-height: 1.6;
		}

		/* ── Error state ── */
		.error-state {
			text-align: center;
			padding: 2rem 1.5rem;
			background: var(--danger-bg);
			border: 1px solid var(--danger);
			border-radius: 12px;
		}
		.error-state p {
			color: var(--danger);
			font-size: 0.9375rem;
			margin-bottom: 1rem;
		}
		.btn-retry {
			background: var(--danger);
			color: white;
			border: none;
			border-radius: 8px;
			padding: 0.625rem 1.25rem;
			font-size: 0.875rem;
			font-weight: 600;
			font-family: var(--font-sans);
			cursor: pointer;
			min-height: 48px;
		}
		.btn-retry:hover {
			opacity: 0.9;
		}

		/* ── Reform cards ── */
		.reform-timeline {
			display: flex;
			flex-direction: column;
			gap: 0.875rem;
		}
		.reform-card {
			background: var(--surface);
			border: 1px solid var(--border-light);
			border-radius: 12px;
			padding: 1.125rem 1.25rem;
			transition: box-shadow 0.2s;
		}
		.reform-card:hover {
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
		}
		.reform-card.is-high {
			border-left: 3px solid var(--accent);
		}
		.reform-date-row {
			display: flex;
			gap: 0.5rem;
			align-items: center;
			flex-wrap: wrap;
			margin-bottom: 0.375rem;
		}
		.reform-date {
			font-size: 0.71875rem;
			color: var(--text-muted);
			font-family: var(--font-mono);
			letter-spacing: 0.02em;
		}
		.reform-type-badge {
			font-size: 0.6875rem;
			font-weight: 500;
			color: var(--text-muted);
		}
		.reform-importance-badge {
			font-size: 0.65625rem;
			font-weight: 600;
			color: var(--accent);
			background: var(--accent-bg);
			padding: 0.125rem 0.5rem;
			border-radius: 4px;
			letter-spacing: 0.02em;
		}
		.reform-matched-tag {
			font-size: 0.65625rem;
			font-weight: 500;
			color: var(--text-muted);
			background: var(--tierra-warm);
			padding: 0.125rem 0.5rem;
			border-radius: 4px;
		}
		.reform-headline {
			font-family: var(--font-serif);
			font-size: 1.0625rem;
			font-weight: 600;
			line-height: 1.35;
			margin: 0.25rem 0 0.375rem;
			color: var(--text);
		}
		.reform-summary {
			font-size: 0.875rem;
			color: var(--text-muted);
			line-height: 1.6;
			margin-bottom: 0.5rem;
		}
		.reform-title-fallback {
			font-family: var(--font-serif);
			font-size: 1.0625rem;
			font-weight: 600;
			line-height: 1.4;
			margin: 0.375rem 0 0.5rem;
			color: var(--text);
		}
		.reform-link {
			font-size: 0.8125rem;
			color: var(--accent);
			font-weight: 500;
		}
		.reform-link:hover {
			text-decoration: underline;
		}

		/* ── RSS CTA ── */
		.rss-cta {
			margin-top: 2.25rem;
			padding: 1.625rem 1.75rem;
			background: var(--tierra-warm);
			border: 1px solid var(--tierra-deep);
			border-radius: 12px;
			text-align: center;
		}
		.rss-cta h2 {
			font-family: var(--font-serif);
			font-size: 1.1875rem;
			font-weight: 700;
			margin: 0 0 0.375rem;
			color: var(--text);
		}
		.rss-cta > p {
			color: var(--text-secondary);
			font-size: 0.84375rem;
			margin-bottom: 0.5rem;
			line-height: 1.55;
		}
		.rss-cta a {
			color: var(--accent);
			text-decoration: underline;
		}

		/* ── Responsive ── */
		@media (max-width: 640px) {
			.cambios-header h1 { font-size: 1.625rem; }
			.cambios-wrap { padding-top: 1.25rem; padding-bottom: 2rem; }
		}
	</style>

	<div class="cambios-wrap">
		<div class="cambios-header">
			<h1>Tus cambios legislativos</h1>
			<div class="cambios-meta" id="cambios-meta"></div>
			<div class="cambios-info" id="cambios-info"></div>
			<AiNotice />
		</div>

		<div id="cambios-content">
			<div class="skeleton-cards">
				<div class="skeleton-card"><div class="skeleton-line" style="width:40%"></div><div class="skeleton-line" style="width:90%"></div><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%"></div></div>
				<div class="skeleton-card"><div class="skeleton-line" style="width:35%"></div><div class="skeleton-line" style="width:85%"></div><div class="skeleton-line"></div><div class="skeleton-line" style="width:55%"></div></div>
				<div class="skeleton-card"><div class="skeleton-line" style="width:45%"></div><div class="skeleton-line" style="width:80%"></div><div class="skeleton-line"></div><div class="skeleton-line" style="width:50%"></div></div>
			</div>
		</div>

		<section class="rss-cta" id="rss-cta" style="visibility:hidden;position:absolute">
			<h2>¿Quieres enterarte sin volver a entrar?</h2>
			<p>Suscríbete a nuestro <a href="/feed.xml">canal RSS de cambios recientes</a> con cualquier lector de noticias. No necesitas darnos ningún dato.</p>
			<p>Tus temas se guardan solo en este navegador: vuelve a esta página cuando quieras y verás lo nuevo.</p>
		</section>
	</div>

	<script is:inline>
		(function () {
			var ANSWER_LABELS = {
				cuenta_ajena: "Empleado/a",
				autonomo: "Autónomo/a",
				empresa: "Empresario/a",
				jubilado: "Jubilado/a",
				busco_empleo: "Busco empleo",
				estudiante: "Estudiante",
				no_trabajo: "No trabajo",
				campo: "Agricultura",
				industria: "Industria",
				energia: "Energía",
				construccion: "Construcción",
				comercio: "Comercio",
				transporte: "Transporte",
				hosteleria: "Hostelería",
				tecnologia: "Tecnología",
				finanzas: "Finanzas",
				servicios_profesionales: "Serv. profesionales",
				admin_publica: "Admin. pública",
				educacion: "Educación",
				sanidad: "Sanidad",
				cultura_deporte: "Cultura y deporte",
				otro: "Otro sector",
				alquilo: "Alquiler",
				hipoteca: "Hipoteca",
				propietario: "Propietario/a",
				familiares: "Vivo con familiares",
				hijos_menores: "Hijos menores",
				dependiente: "Familiar dependiente",
				embarazo_baja: "Embarazo/baja",
				coche: "Conduzco",
				inversiones: "Inversiones",
				mascotas: "Mascotas",
				casero: "Casero/a",
				divorcio: "Divorcio",
				discapacidad: "Discapacidad",
				extranjeria: "Extranjería",
				ecommerce: "E-commerce",
				herencia: "Herencia",
				medioambiente: "Medio ambiente",
				deporte: "Deporte"
			};

			var JURISDICTION_NAMES = {
				es: "Estatal", "es-an": "Andalucía", "es-ar": "Aragón", "es-as": "Asturias",
				"es-cb": "Cantabria", "es-cl": "Castilla y León", "es-cm": "Castilla-La Mancha",
				"es-cn": "Canarias", "es-ct": "Cataluña", "es-ex": "Extremadura", "es-ga": "Galicia",
				"es-ib": "Illes Balears", "es-mc": "Murcia", "es-md": "Madrid", "es-nc": "Navarra",
				"es-pv": "País Vasco", "es-ri": "La Rioja", "es-vc": "C. Valenciana"
			};

			function esc(s) { return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }

			var API = document.documentElement.dataset.api;
			var contentDiv = document.getElementById("cambios-content");
			var metaDiv = document.getElementById("cambios-meta");
			var infoDiv = document.getElementById("cambios-info");
			var rssCta = document.getElementById("rss-cta");

			var perfil = null;
			try {
				perfil = JSON.parse(localStorage.getItem("leyabierta_perfil") || "null");
			} catch (e) {}

			var answersObj = perfil ? (perfil.answers || {}) : {};
			if (!perfil || !answersObj.workStatus) {
				window.location.href = "/mi-situacion/";
				return;
			}

			var jurisdiccion = perfil.jurisdiccion || "es";

			// Render header tags
			var pillsHtml = "";
			var tagKeys = [];
			if (answersObj.workStatus) tagKeys.push(answersObj.workStatus);
			if (answersObj.sector) tagKeys.push(answersObj.sector);
			if (answersObj.housing) tagKeys.push(answersObj.housing);
			if (answersObj.family) {
				for (var fi = 0; fi < answersObj.family.length; fi++) tagKeys.push(answersObj.family[fi]);
			}
			if (answersObj.extras) {
				for (var ei = 0; ei < answersObj.extras.length; ei++) tagKeys.push(answersObj.extras[ei]);
			}
			for (var t = 0; t < tagKeys.length; t++) {
				var label = ANSWER_LABELS[tagKeys[t]] || tagKeys[t];
				pillsHtml += '<span class="situation-tag">' + esc(label) + '</span>';
			}
			metaDiv.innerHTML = pillsHtml;
			infoDiv.innerHTML = esc(JURISDICTION_NAMES[jurisdiccion] || jurisdiccion) + ' · Últimos cambios · <a href="/mi-situacion/">Cambiar situación</a>';

			var PAGE_SIZE = 20;
			var currentOffset = 0;
			var timelineEl = null;
			var loadMoreBtn = null;

			var TYPE_LABELS = {
				new_law: "Ley nueva",
				modification: "Modificación",
				correction: "Corrección",
				derogation: "Derogación"
			};

			function buildBaseParams() {
				var params = "w=" + encodeURIComponent(answersObj.workStatus);
				if (answersObj.sector) params += "&s=" + encodeURIComponent(answersObj.sector);
				if (answersObj.housing) params += "&h=" + encodeURIComponent(answersObj.housing);
				params += "&j=" + encodeURIComponent(jurisdiccion);
				if (answersObj.family && answersObj.family.length) params += "&f=" + encodeURIComponent(answersObj.family.join(","));
				if (answersObj.extras && answersObj.extras.length) params += "&x=" + encodeURIComponent(answersObj.extras.join(","));
				return params;
			}

			function renderCards(reforms) {
				var html = "";
				for (var i = 0; i < reforms.length; i++) {
					var r = reforms[i];
					var dateStr = r.date || "";
					if (dateStr) {
						var d = new Date(dateStr + "T00:00:00");
						var months = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
						dateStr = d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
					}
					var hasHeadline = r.headline && r.headline.length > 0;
					var reformType = r.reform_type || "";
					var typeLabel = TYPE_LABELS[reformType] || "";
					var isHigh = r.importance === "high";

					html += '<div class="reform-card' + (isHigh ? ' is-high' : '') + '">';
					html += '<div class="reform-date-row">';
					html += '<span class="reform-date">' + esc(dateStr) + '</span>';
					if (typeLabel) html += '<span class="reform-type-badge"> · ' + esc(typeLabel) + '</span>';
					if (isHigh) html += '<span class="reform-importance-badge">Cambio importante</span>';
					// matched tags from API if present
					if (r.matched_tags && r.matched_tags.length) {
						for (var mt = 0; mt < r.matched_tags.length; mt++) {
							html += '<span class="reform-matched-tag">↳ ' + esc(r.matched_tags[mt]) + '</span>';
						}
					}
					html += '</div>';

					if (hasHeadline) {
						html += '<h3 class="reform-headline">' + esc(r.headline) + '</h3>';
						if (r.summary) html += '<p class="reform-summary">' + esc(r.summary) + '</p>';
					} else {
						html += '<h3 class="reform-title-fallback">' + esc(r.title) + '</h3>';
					}

					html += '<a href="/cambios/reforma/?id=' + encodeURIComponent(r.id) + '&date=' + encodeURIComponent(r.date) + '&from=mis-cambios" class="reform-link">Ver qué cambió →</a>';
					html += '</div>';
				}
				return html;
			}

			function updateInfoDate() {
				if (!timelineEl) return;
				var cards = timelineEl.querySelectorAll(".reform-card .reform-date");
				if (cards.length === 0) return;
				var oldest = cards[cards.length - 1].textContent;
				infoDiv.innerHTML = esc(JURISDICTION_NAMES[jurisdiccion] || jurisdiccion) + ' · Desde ' + esc(oldest) + ' · <a href="/mi-situacion/">Cambiar situación</a>';
			}

			function fetchPage(offset, isInitial) {
				var params = buildBaseParams() + "&limit=" + PAGE_SIZE + "&offset=" + offset;

				var controller = new AbortController();
				var timeout = setTimeout(function () { controller.abort(); }, 10000);

				if (loadMoreBtn) {
					loadMoreBtn.disabled = true;
					loadMoreBtn.textContent = "Cargando...";
				}

				fetch(API + "/v1/reforms/personal?" + params, { signal: controller.signal })
					.then(function (r) { return r.json(); })
					.then(function (data) {
						clearTimeout(timeout);
						if (!data.reforms) data.reforms = [];

						if (isInitial && data.reforms.length === 0) {
							contentDiv.innerHTML = '<div class="empty-state"><div class="empty-check">&#10003;</div><h2>No hay cambios recientes que te afecten</h2><p>¡Buenas noticias! Vuelve cuando quieras: aquí verás lo que cambie en las leyes que tocan tu situación.</p></div>';
							rssCta.style.visibility = "";
							rssCta.style.position = "";
							return;
						}

						if (isInitial) {
							contentDiv.innerHTML = '<div class="reform-timeline" id="reform-timeline"></div>';
							timelineEl = document.getElementById("reform-timeline");
						}

						timelineEl.insertAdjacentHTML("beforeend", renderCards(data.reforms));
						currentOffset = offset + data.reforms.length;
						updateInfoDate();

						if (data.reforms.length >= PAGE_SIZE) {
							if (!loadMoreBtn) {
								loadMoreBtn = document.createElement("button");
								loadMoreBtn.type = "button";
								loadMoreBtn.className = "btn";
								loadMoreBtn.textContent = "Ver más";
								loadMoreBtn.style.display = "block";
								loadMoreBtn.style.margin = "1.5rem auto 0";
								loadMoreBtn.addEventListener("click", function () {
									fetchPage(currentOffset, false);
								});
								contentDiv.appendChild(loadMoreBtn);
							} else {
								loadMoreBtn.disabled = false;
								loadMoreBtn.textContent = "Ver más";
							}
						} else if (loadMoreBtn) {
							loadMoreBtn.remove();
							loadMoreBtn = null;
						}

						rssCta.style.visibility = "";
						rssCta.style.position = "";
					})
					.catch(function () {
						clearTimeout(timeout);
						if (isInitial) {
							contentDiv.innerHTML = '<div class="error-state" role="alert"><p>Error al cargar. Inténtalo de nuevo.</p><button type="button" class="btn-retry" id="btn-retry">Reintentar</button></div>';
							var retryBtn = document.getElementById("btn-retry");
							if (retryBtn) {
								retryBtn.addEventListener("click", function () { fetchPage(0, true); });
							}
						} else if (loadMoreBtn) {
							loadMoreBtn.disabled = false;
							loadMoreBtn.textContent = "Ver más";
						}
					});
			}

			fetchPage(0, true);

		})();
	</script>
</Base>
