---
import { getCollection } from "astro:content";
import { promises as fs } from "node:fs";
import Base from "../../layouts/Base.astro";
import { escapeHtml, safeJsonLd } from "../../lib/escape";
import { getLaw } from "../../lib/api.ts";
import {
	AI_SUMMARIES_EXPLAINER_HREF,
	articleLabel,
	matchArticleSummaries,
} from "../../lib/article-summaries.ts";
import { reformCanonicalPath } from "../../lib/reform-experiment.ts";
import {
	isIndexableLaw,
	loadArticleSummaries,
	loadManifest,
} from "../../lib/manifest.ts";
import { hubsForLaw } from "../../components/topic-hubs";
import { effectiveLastUpdated } from "../../lib/law-dates.ts";
import {
	boeUrl,
	capitalize,
	formatDate,
	lawTextPath,
	RANK_LABELS,
	STATUS_LABELS,
} from "../../lib/law-labels.ts";
import { lawBody, renderLawHtml } from "../../lib/law-text.ts";

// A related norm shown in the "Normas relacionadas" internal-linking block.
interface RelatedLaw {
	id: string;
	titulo: string;
}

export async function getStaticPaths() {
	const laws = await getCollection("laws");
	const allIds = new Set(laws.map((e) => e.data.identificador));

	// Materias come from the build manifest (DB-sourced), not the .md frontmatter:
	// the published leyes repo does not carry `materias`, so relying on frontmatter
	// left every ficha with empty materias — no tags and no "Normas relacionadas"
	// block. Fall back to frontmatter for local dev where no manifest is present.
	const manifest = loadManifest();
	const materiasFor = (identificador: string, fm: string[] | undefined) =>
		manifest?.citizens[identificador]?.materias ?? fm ?? [];

	// ── SEO: topical internal linking ──────────────────────────────────────
	// Leaf law pages otherwise only link to explicit references (many of which
	// are not in-corpus, so they render as plain text). That leaves ~12k pages
	// weakly interlinked, which Google reads as low-value ("Crawled - currently
	// not indexed"). We build topical clusters by linking each norm to siblings
	// that share the most specific materias, with real /leyes/<id>/ links.
	//
	// Dedup by identificador first (data-integrity invariant: one norm, one entry).
	const byId = new Map<
		string,
		{ id: string; titulo: string; jurisdiccion: string; estado: string; materias: string[] }
	>();
	for (const e of laws) {
		const d = e.data;
		if (byId.has(d.identificador)) continue;
		byId.set(d.identificador, {
			id: d.identificador,
			titulo: d.titulo,
			jurisdiccion: d.jurisdiccion,
			estado: d.estado,
			materias: materiasFor(d.identificador, d.materias),
		});
	}
	const materiaIndex = new Map<string, string[]>();
	for (const l of byId.values()) {
		for (const m of l.materias) {
			let bucket = materiaIndex.get(m);
			if (!bucket) {
				bucket = [];
				materiaIndex.set(m, bucket);
			}
			bucket.push(l.id);
		}
	}

	// Very broad materias (e.g. "Derecho administrativo") carry little topical
	// signal and would just add noise, so we skip them when scoring.
	const GENERIC_MATERIA_MAX = 400;

	function relatedFor(id: string, materias: string[], jurisdiccion: string): RelatedLaw[] {
		if (materias.length === 0) return [];
		// Prefer specific (small-bucket) materias first: they signal a stronger
		// topical match than generic ones.
		const ordered = [...materias].sort(
			(a, b) => (materiaIndex.get(a)?.length ?? 0) - (materiaIndex.get(b)?.length ?? 0),
		);
		const score = new Map<string, number>();
		for (const m of ordered) {
			const bucket = materiaIndex.get(m);
			if (!bucket || bucket.length > GENERIC_MATERIA_MAX) continue;
			for (const otherId of bucket) {
				if (otherId === id) continue;
				score.set(otherId, (score.get(otherId) ?? 0) + 1);
			}
			if (score.size > 200) break; // enough candidates to rank
		}
		return [...score.entries()]
			.map(([otherId, shared]) => ({ shared, l: byId.get(otherId) }))
			.filter((x): x is { shared: number; l: NonNullable<typeof x.l> } => !!x.l && x.l.estado !== "derogada")
			.sort(
				(a, b) =>
					b.shared - a.shared ||
					Number(b.l.jurisdiccion === jurisdiccion) - Number(a.l.jurisdiccion === jurisdiccion),
			)
			.slice(0, 6)
			.map((x) => ({ id: x.l.id, titulo: x.l.titulo }));
	}

	return laws.map((entry) => ({
		params: { id: entry.data.identificador },
		props: {
			entry,
			allIds,
			related: relatedFor(
				entry.data.identificador,
				materiasFor(entry.data.identificador, entry.data.materias),
				entry.data.jurisdiccion,
			),
		},
	}));
}

const { entry, allIds, related } = Astro.props;
const { id } = Astro.params;
const law = entry.data;
// Never read law.ultima_actualizacion directly: it can lag the reforms list or
// be corrupt. See lib/law-dates.ts.
const lastUpdated = effectiveLastUpdated(law);

// Topic hubs this norm is curated into, so the page can link back to them.
// The hub→ley link already existed; without this one the cluster is a dead end
// and the hubs sat with no inbound internal links at all (see topic-hubs.ts).
const lawHubs = hubsForLaw(id!);

// Fetch citizen data (summary + tags).
// If a build manifest is present (CI), read from local file (zero network calls).
// Otherwise fall back to per-page API calls (local dev).
let citizenSummary = "";
let citizenTags: string[] = [];
const manifest = loadManifest();
if (manifest) {
	const citizenData = manifest.citizens[id!];
	citizenSummary = citizenData?.summary ?? "";
	citizenTags = citizenData?.tags ?? [];
} else {
	try {
		const detail = await getLaw(id!);
		citizenSummary = detail.citizen_summary ?? "";
		citizenTags = detail.citizen_tags ?? [];
	} catch {
		// API may not be available during build — gracefully degrade
	}
}

// Article summaries ("Artículo por artículo"). The legal text itself lives on
// /leyes/[id]/texto/; here we only need each summary's anchor there, so the
// body is rendered (unsanitized: sanitizing never touches heading ids or text)
// with the same renderer and matcher the text page uses, and then dropped.
const articlePairs = loadArticleSummaries()?.[id!];
let articleItems: Array<{ label: string; summary: string; href: string }> = [];
if (articlePairs?.some(([, s]) => s)) {
	let html = "";
	if (entry.body) {
		const raw = await fs.readFile(entry.body, "utf-8");
		html = renderLawHtml(lawBody(raw), false);
	}
	articleItems = matchArticleSummaries(html, articlePairs, { inject: false }).items.map(
		(item) => ({
			label: articleLabel(item.heading, item.section),
			summary: item.summary,
			// Relative to /leyes/<id>/: keeps 1,000+ links per big code short.
			href: `texto/${item.anchor ? `#${item.anchor}` : ""}`,
		}),
	);
}
// Pre-rendered as one string: as Astro template nodes every element would
// also carry a scoped-style attribute (~90 bytes per article on big codes).
const articleListHtml = articleItems
	.map(
		(a) =>
			`<li><h3><a href="${escapeHtml(a.href)}">${escapeHtml(a.label)}</a></h3><p>${escapeHtml(a.summary)}</p></li>`,
	)
	.join("");

// AI headline/summary per reform, looked up by date + reforming norm.
const reformSummaries = new Map(
	(manifest?.reforms?.[id!] ?? []).map((r) => [`${r.date}|${r.source}`, r]),
);
const indexable = isIndexableLaw(id!);
const hasAiContent =
	!!citizenSummary || articleItems.length > 0 || reformSummaries.size > 0;

// legislationType accepts free text (schema.org examples: "law", "decree", "loi organique")
const RANK_LEGISLATION_TYPES: Record<string, string> = {
	constitucion: "Constitution",
	ley_organica: "OrganicLaw",
	ley: "Law",
	real_decreto_ley: "RoyalDecreeLaw",
	real_decreto_legislativo: "RoyalLegislativeDecree",
	real_decreto: "RoyalDecree",
	orden: "MinisterialOrder",
	decreto: "Decree",
	circular: "Circular",
	resolucion: "Resolution",
	acuerdo_internacional: "InternationalAgreement",
	instruccion: "Instruction",
	reglamento: "Regulation",
};


const reforms = (law.reformas ?? []).slice().reverse();
// Prefer DB-sourced materias from the manifest (the published leyes frontmatter
// may not carry them); fall back to frontmatter for local dev without a manifest.
const materias = manifest?.citizens[id!]?.materias ?? law.materias ?? [];
const notas = law.notas ?? [];
const refsAnt = law.referencias_anteriores ?? [];
const refsPost = law.referencias_posteriores ?? [];
const articleCount = law.articulos ?? 0;

// ── SEO: generate abbreviation variants (e.g. "RD 769/87") ──
const RANK_ABBREVS: Record<string, string> = {
	real_decreto: "RD", ley_organica: "LO", ley: "L",
	real_decreto_ley: "RDL", real_decreto_legislativo: "RDLeg",
	orden: "O", decreto: "D", resolucion: "Res",
};
const abbrev = RANK_ABBREVS[law.rango] ?? "";
let seoAbbreviations: string[] = [];
if (abbrev) {
	// Extract "769/1987" from title like "Real Decreto 769/1987, de 19 de junio..."
	const numMatch = law.titulo.match(/(\d+\/\d{4})/);
	if (numMatch) {
		const full = numMatch[1]!; // "769/1987"
		const short2 = full.replace(/\/(\d{2})\d{2}$/, "/$1"); // "769/19" — wrong
		const short2digit = full.replace(/\/\d{2}(\d{2})$/, "/$1"); // "769/87"
		seoAbbreviations.push(`${abbrev} ${full}`); // "RD 769/1987"
		if (short2digit !== full) seoAbbreviations.push(`${abbrev} ${short2digit}`); // "RD 769/87"
	}
}
const seoDescription = [
	seoAbbreviations[0],
	citizenSummary || (RANK_LABELS[law.rango] ?? law.rango),
	law.estado === "vigente" ? "En vigor" : law.estado === "derogada" ? "Ya no está en vigor" : "",
	law.departamento,
].filter(Boolean).join(" · ");
---

<Base
	title={seoAbbreviations[0] ? `${seoAbbreviations[0]} — ${law.titulo}` : law.titulo}
	description={seoDescription}
	ogTitle={law.titulo}
	ogType="article"
	ogImage={`${import.meta.env.PUBLIC_API_URL ?? "https://api.leyabierta.es"}/og/${id}`}
	canonicalUrl={`/leyes/${id}/`}
	noindex={!indexable}
>
	<!-- JSON-LD: Legislation -->
	<script type="application/ld+json" set:html={safeJsonLd({
		"@context": "https://schema.org",
		"@type": "Legislation",
		"name": law.titulo,
		"identifier": law.identificador,
		"description": citizenSummary || law.titulo.slice(0, 160),
		"legislationDate": law.fecha_publicacion,
		...(lastUpdated ? { "legislationDateVersion": lastUpdated, "dateModified": lastUpdated } : {}),
		"legislationJurisdiction": law.jurisdiccion === "es" ? "ES" : law.jurisdiccion.toUpperCase(),
		...(law.estado === "vigente" || law.estado?.startsWith("derogad")
			? { "legislationLegalForce": law.estado === "vigente" ? "InForce" : "NotInForce" }
			: {}),
		...(RANK_LEGISLATION_TYPES[law.rango] ? { "legislationType": RANK_LEGISLATION_TYPES[law.rango] } : {}),
		...(materias.length > 0 ? { "about": materias.map(m => ({ "@type": "Thing", "name": m })) } : {}),
		"inLanguage": "es",
		"url": `https://leyabierta.es/leyes/${id}/`,
		"isPartOf": { "@type": "WebSite", "@id": "https://leyabierta.es/#website" },
		...(seoAbbreviations.length > 0 ? { "alternateName": seoAbbreviations } : {}),
		...(law.fuente ? { "sameAs": law.fuente } : {})
	})} />
	<script type="application/ld+json" set:html={safeJsonLd({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://leyabierta.es/" },
			...(lawHubs[0]
				? [{ "@type": "ListItem", "position": 2, "name": lawHubs[0].backlinkLabel, "item": `https://leyabierta.es${lawHubs[0].path}` }]
				: []),
			{ "@type": "ListItem", "position": lawHubs[0] ? 3 : 2, "name": law.titulo, "item": `https://leyabierta.es/leyes/${id}/` }
		]
	})} />
	<style>
		.back-link { font-size: 0.8125rem; color: var(--text-muted); }
		.back-link:hover { color: var(--text-secondary); }

		.meta-hub { color: var(--accent); }
		.meta-hub:hover { text-decoration: underline; }

		.law-header {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			gap: 1rem;
			margin: 0.75rem 0 0.5rem;
		}
		.law-title {
			font-family: var(--font-serif);
			font-size: 1.375rem;
			font-weight: 700;
			line-height: 1.35;
			letter-spacing: -0.01em;
			flex: 1;
		}
		.boe-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: 0.4rem 0.875rem;
			border: 1.5px solid var(--border);
			border-radius: 6px;
			font-size: 0.8125rem;
			font-weight: 600;
			color: var(--text-secondary);
			background: var(--surface);
			white-space: nowrap;
			flex-shrink: 0;
			transition: all 0.15s;
		}
		.boe-btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

		.meta-row {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			align-items: center;
			font-size: 0.8125rem;
			color: var(--text-muted);
			margin-bottom: 1.5rem;
			line-height: 1.4;
		}
		.meta-sep { color: var(--border); }
		.meta-item { display: inline-flex; align-items: center; gap: 0.3rem; }
		.meta-item svg { flex-shrink: 0; opacity: 0.5; }
		.meta-id { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); position: relative; top: 0.5px; }

		/* ── Resumen components ── */

		.quick-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
		.stat-card { display: flex; align-items: center; gap: 0.625rem; padding: 0.875rem 1rem; background: var(--surface); border: 1px solid var(--border-light); border-radius: 10px; }
		.stat-value { font-variant-numeric: tabular-nums; font-size: 1.25rem; font-weight: 700; color: var(--accent); line-height: 1.2; }
		.stat-label { font-size: 0.6875rem; color: var(--text-muted); }

		.card { background: var(--surface); border: 1px solid var(--border-light); border-radius: 10px; padding: 1.25rem 1.5rem; margin-bottom: 1rem; }
		.card-heading { font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; }
		.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; font-size: 0.875rem; }
		.meta-item-label { color: var(--text-muted); font-size: 0.8125rem; margin-bottom: 0.125rem; }
		.meta-item-value { color: var(--text); font-weight: 500; }

		.citizen-summary-card {
			padding: 0.25rem 0 0.25rem 1rem;
			border-left: 3px solid var(--accent);
			margin-bottom: 1.5rem;
		}
		.citizen-summary-label {
			font-size: 0.6875rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--accent);
			margin-bottom: 0.375rem;
		}
		.citizen-summary {
			font-size: 1rem;
			color: var(--text-secondary);
			line-height: 1.7;
			margin: 0;
		}
		.citizen-tags {
			margin-top: 2rem;
			padding-top: 1.25rem;
			border-top: 1px solid var(--border-light);
		}
		.citizen-tag {
			display: inline-block;
			padding: 0.25rem 0.625rem;
			font-size: 0.6875rem;
			color: var(--text-muted);
			border: 1px solid var(--border-light);
			border-radius: 100px;
			margin: 0.1875rem 0.125rem;
		}

		.section { margin-bottom: 2rem; }
		.section-heading { font-size: 1.0625rem; font-weight: 600; margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-light); }
		.materia-tag { display: inline-block; padding: 0.25rem 0.75rem; border: 1px solid var(--border); border-radius: 100px; font-size: 0.8125rem; color: var(--text-secondary); margin: 0.125rem 0.25rem 0.125rem 0; transition: all 0.15s; }
		.materia-tag:hover { background: var(--accent-bg); color: var(--accent); border-color: var(--accent); text-decoration: none; }
		.ref-list { list-style: disc; padding-left: 1.5rem; margin: 0; }
		.ref-list li { font-size: 0.875rem; line-height: 1.65; color: var(--text-secondary); margin-bottom: 0.375rem; }
		.ref-list a { font-family: var(--font-mono); font-size: 0.8125rem; }
		.ref-list-related a { font-family: var(--font-sans); font-size: 0.875rem; }
		.nota-item { font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0.375rem; }

		/* ── Timeline ── */
		.timeline { list-style: none; padding: 0; }
		.timeline-item { position: relative; padding: 0 0 1rem 1.5rem; }
		.timeline-item::before { content: ""; position: absolute; left: 0.28rem; top: 0.5rem; bottom: -0.25rem; width: 1px; background: var(--border); }
		.timeline-item:last-child::before { display: none; }
		.timeline-dot { position: absolute; left: 0; top: 0.35rem; width: 0.625rem; height: 0.625rem; border-radius: 50%; border: 2px solid var(--border); background: var(--bg); }
		.timeline-item:first-child .timeline-dot { border-color: var(--accent); background: var(--accent); }
		.timeline-date { font-weight: 600; font-size: 0.8125rem; }
		.timeline-detail { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.125rem; }
		.timeline-link { font-size: 0.75rem; margin-top: 0.25rem; display: inline-block; padding: 0.8rem 0; margin-bottom: -0.8rem; }

		/* ── Follow card ── */
		.follow-card {
			display: flex;
			gap: 1rem;
			align-items: flex-start;
			padding: 1.25rem 1.5rem;
			background: var(--accent-bg);
			border: 1px solid var(--border-light);
			border-radius: 10px;
			margin-top: 2rem;
		}
		.follow-icon {
			flex-shrink: 0;
			color: var(--accent);
			margin-top: 0.125rem;
		}
		.follow-content { flex: 1; min-width: 0; }
		.follow-heading {
			font-size: 0.9375rem;
			font-weight: 600;
			color: var(--text);
			margin: 0 0 0.25rem;
		}
		.follow-desc {
			font-size: 0.8125rem;
			color: var(--text-muted);
			margin: 0 0 0.75rem;
			line-height: 1.5;
		}
		.follow-input-row {
			display: flex;
			gap: 0.5rem;
		}
		.follow-input {
			flex: 1;
			min-width: 0;
			padding: 0.5rem 0.75rem;
			border: 1px solid var(--border);
			border-radius: 6px;
			font-size: 0.875rem;
			font-family: var(--font-sans);
			background: var(--bg);
			color: var(--text);
		}
		.follow-input:focus {
			outline: none;
			border-color: var(--accent);
			box-shadow: 0 0 0 2px rgba(26, 54, 93, 0.1);
		}
		.follow-btn {
			padding: 0.5rem 1rem;
			background: var(--accent);
			color: #fff;
			border: none;
			border-radius: 6px;
			font-size: 0.8125rem;
			font-weight: 600;
			font-family: var(--font-sans);
			cursor: pointer;
			white-space: nowrap;
			transition: background 0.15s;
		}
		.follow-btn:hover { background: var(--accent); color: white; }
		.follow-btn:disabled { opacity: 0.6; cursor: not-allowed; }
		.follow-msg {
			font-size: 0.8125rem;
			line-height: 1.5;
			margin-top: 0.5rem;
		}
		.follow-msg.success { color: #22c55e; }
		.follow-msg.error { color: #ef4444; }

		@media (max-width: 640px) {
			.law-header { flex-direction: column; }
			.meta-grid { grid-template-columns: 1fr; }
			.quick-stats { grid-template-columns: repeat(2, 1fr); }
			.follow-card { flex-direction: column; gap: 0.5rem; }
			.follow-icon { display: none; }
			.follow-input-row { flex-direction: column; }
		}

		/* ── Own-content sections (summary page) ── */
		.law-section { margin: 2.5rem 0 0; }
		.law-section-heading {
			font-family: var(--font-serif);
			font-size: 1.25rem;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.5rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--border-light);
		}
		.law-section-intro { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; margin: 0 0 1rem; }

		/* AI note: warm cream = the system speaking in a human voice (DESIGN.md). */
		.ai-note {
			font-size: 0.8125rem;
			color: var(--text-secondary);
			line-height: 1.55;
			margin: 0.75rem 0 0;
			padding: 0.5rem 0.75rem;
			background: var(--tierra-warm);
			border: 1px solid var(--tierra-deep);
			border-radius: 8px;
		}

		.text-cta {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem 1.25rem;
			padding: 1rem 1.25rem;
			margin: 0 0 1.5rem;
			background: var(--accent-faint);
			border: 1px solid var(--border);
			border-radius: 10px;
		}
		.text-cta p { margin: 0; flex: 1 1 18rem; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.55; }
		.text-cta-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
		.btn-primary, .btn-outline {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: 0.5rem 0.875rem;
			border-radius: 6px;
			font-size: 0.8125rem;
			font-weight: 600;
			white-space: nowrap;
		}
		.btn-primary { background: var(--accent); color: #fff; border: 1.5px solid var(--accent); }
		.btn-primary:hover { color: #fff; text-decoration: underline; }
		.btn-outline { background: var(--surface); color: var(--text-secondary); border: 1.5px solid var(--border); }
		.btn-outline:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

		.reform-headline { font-family: var(--font-serif); font-size: 1rem; font-weight: 600; color: var(--text); margin: 0.25rem 0 0; line-height: 1.4; }
		.reform-summary { font-size: 0.875rem; color: var(--text-secondary); line-height: 1.6; margin: 0.25rem 0 0; }

		.art-list { list-style: none; padding: 0; margin: 0; }
		.art-list :global(li) { padding: 0.875rem 0; border-bottom: 1px solid var(--border-light); }
		.art-list :global(li:last-child) { border-bottom: none; }
		.art-list :global(h3) { font-family: var(--font-serif); font-size: 1rem; font-weight: 600; line-height: 1.4; margin: 0 0 0.25rem; }
		.art-list :global(h3 a) { color: var(--text); }
		.art-list :global(h3 a:hover) { color: var(--accent); }
		.art-list :global(p) { font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.65; margin: 0; }
	</style>

	<a href="/" class="back-link" id="back-link">&larr; Volver</a>
	<script is:inline>
		(function() {
			var link = document.getElementById("back-link");
			if (document.referrer && document.referrer.indexOf(location.origin) === 0) {
				link.addEventListener("click", function(e) {
					e.preventDefault();
					history.back();
				});
				var refPath = new URL(document.referrer).pathname;
				if (refPath === "/" || refPath.indexOf("/?") === 0) {
					link.textContent = "\u2190 Volver a resultados";
				} else if (refPath === "/cambios/") {
					link.textContent = "\u2190 Volver a cambios recientes";
				} else if (refPath === "/cambios/mias/") {
					link.textContent = "\u2190 Volver a mis cambios";
				}
			}
		})();
	</script>

	<div class="law-header">
		<div>
			<div style="display: flex; gap: 0.375rem; margin-bottom: 0.375rem;">
				<span class={`badge badge-${law.estado}`} style="text-transform:none">{STATUS_LABELS[law.estado] ?? law.estado}</span>
				<span class="badge" style="background: var(--accent-bg); color: var(--accent);">{RANK_LABELS[law.rango] ?? law.rango}</span>
			</div>
			<h1 class="law-title">{law.titulo}</h1>
			{seoAbbreviations.length > 0 && <span class="sr-only">También conocida como: {seoAbbreviations.join(", ")}</span>}
		</div>
		<a href={`https://www.boe.es/buscar/act.php?id=${law.identificador}`} target="_blank" rel="noopener" class="boe-btn">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
			Ver en BOE
		</a>
	</div>

	<div class="meta-row">
		<span class="meta-item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
			{formatDate(law.fecha_publicacion)}
		</span>
		{lastUpdated && lastUpdated !== law.fecha_publicacion && (
			<>
				<span class="meta-sep">&middot;</span>
				<span class="meta-item">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
					{formatDate(lastUpdated)}
				</span>
			</>
		)}
		<span class="meta-sep">&middot;</span>
		<span class="meta-item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
			{law.departamento}
		</span>
		<span class="meta-sep">&middot;</span>
		<span class="meta-item meta-id">{id}</span>
		{lawHubs.map(hub => (
			<>
				<span class="meta-sep">&middot;</span>
				<a class="meta-item meta-hub" href={hub.path}>{hub.backlinkLabel}</a>
			</>
		))}
	</div>

	<!-- Own content only: no BOE article text on this page. The full text is on
	     /leyes/[id]/texto/ (noindex), linked from here and from every article. -->
	<div id="resumen">
		{citizenSummary && (
			<div class="citizen-summary-card">
				<div class="citizen-summary-label">Resumen en lenguaje sencillo</div>
				<p class="citizen-summary">{citizenSummary}</p>
			</div>
		)}

		{hasAiContent && (
			<p class="ai-note">
				Los resúmenes de esta página están escritos en lenguaje sencillo y generados con IA a partir
				del texto oficial. No son asesoramiento jurídico: lo que vale es el texto publicado en el BOE.{" "}
				<a href={AI_SUMMARIES_EXPLAINER_HREF}>Cómo los hacemos</a>.
			</p>
		)}
	</div>

	<div class="text-cta" style="margin-top: 1.5rem;">
		<p>
			{articleItems.length > 0
				? "El texto completo de la ley, con el resumen de cada artículo a su lado."
				: "El texto completo de la ley, tal como lo publica el BOE."}
		</p>
		<div class="text-cta-actions">
			<a href={lawTextPath(id!)} class="btn-primary">Leer el texto completo</a>
			<a href={boeUrl(law.identificador)} target="_blank" rel="noopener" class="btn-outline">Ver en el BOE</a>
		</div>
	</div>

	<div class="quick-stats">
		{articleCount > 0 && (
			<div class="stat-card"><div><div class="stat-value">{articleCount}</div><div class="stat-label">Artículos</div></div></div>
		)}
		{reforms.length > 0 && (
			<div class="stat-card"><div><div class="stat-value">{reforms.length}</div><div class="stat-label">Versiones</div></div></div>
		)}
		{materias.length > 0 && (
			<div class="stat-card"><div><div class="stat-value">{materias.length}</div><div class="stat-label">Categorías</div></div></div>
		)}
	</div>

	<!-- Qué ha cambiado: reform timeline with AI headlines where available -->
	<section class="law-section" id="reformas" aria-labelledby="reformas-heading">
		<h2 class="law-section-heading" id="reformas-heading">Qué ha cambiado</h2>
		{reforms.length <= 1 ? (
			<p class="law-section-intro">Esta ley no tiene modificaciones registradas desde su publicación.</p>
		) : (
			<>
				<p class="law-section-intro">
					{reforms.length - 1} {reforms.length - 1 === 1 ? "modificación" : "modificaciones"} desde su publicación, de la más reciente a la más antigua.
				</p>
				<ul class="timeline">
					{reforms.map((reform, i) => {
						const isOriginal = i === reforms.length - 1;
						// Link to the reform's canonical URL form (path for the
						// experiment cohort, query for the rest) so internal links and
						// the sitemap agree. `from=law` stays a UI-only param — it
						// drives the back link and is absent from the canonical.
						const canonical = reformCanonicalPath(id, reform.fecha);
						const reformaUrl = !isOriginal
							? `${canonical}${canonical.includes("?") ? "&" : "?"}from=law`
							: null;
						const rs = isOriginal ? undefined : reformSummaries.get(`${reform.fecha}|${reform.fuente}`);
						return (
							<li class="timeline-item">
								<div class="timeline-dot"></div>
								<div class="timeline-date">{formatDate(reform.fecha)}</div>
								{rs?.headline && <p class="reform-headline">{rs.headline}</p>}
								{rs?.summary && <p class="reform-summary">{rs.summary}</p>}
								<div class="timeline-detail">
									{isOriginal ? 'Versión original' : `Reforma`}
									{' '}<span style="font-family:var(--font-mono);font-size:0.6875rem">{reform.fuente}</span>
								</div>
								{reformaUrl && <a href={reformaUrl} class="timeline-link">Ver qué cambió &rarr;</a>}
							</li>
						);
					})}
				</ul>
			</>
		)}
	</section>

	<!-- Artículo por artículo: every plain-language article summary -->
	{articleItems.length > 0 && (
		<section class="law-section" id="articulos" aria-labelledby="articulos-heading">
			<h2 class="law-section-heading" id="articulos-heading">Artículo por artículo</h2>
			<p class="law-section-intro">
				Qué dice cada artículo, en lenguaje sencillo ({articleItems.length.toLocaleString("es-ES")} {articleItems.length === 1 ? "artículo" : "artículos"} con resumen).
				Pulsa en un artículo para leer su texto oficial.
			</p>
			<ol class="art-list" set:html={articleListHtml} />
		</section>
	)}

	<div class="law-section">
	<!-- Technical details (always visible) -->
	<div class="technical-details" id="technical-details">
		<div class="card">
			<h2 class="card-heading">Información general</h2>
			<div class="meta-grid">
				<div><div class="meta-item-label">Tipo de ley</div><div class="meta-item-value">{RANK_LABELS[law.rango] ?? capitalize(law.rango.replace(/_/g, ' '))}</div></div>
				<div><div class="meta-item-label">Vigencia</div><div class="meta-item-value">{STATUS_LABELS[law.estado] ?? capitalize(law.estado.replace(/_/g, ' '))}</div></div>
				<div><div class="meta-item-label">Publicación</div><div class="meta-item-value">{formatDate(law.fecha_publicacion)}</div></div>
				<div><div class="meta-item-label">Departamento</div><div class="meta-item-value">{law.departamento}</div></div>
			</div>
		</div>

		{materias.length > 0 && (
			<div class="section">
				<h2 class="section-heading">Temas</h2>
				<div>
					{materias.map((m) => (
						<a href={`/?materia=${encodeURIComponent(m)}`} class="materia-tag">{m}</a>
					))}
				</div>
			</div>
		)}

		{notas.length > 0 && (
			<div class="section">
				<h2 class="section-heading">Notas oficiales</h2>
				{notas.map((nota) => (
					<p class="nota-item">{nota}</p>
				))}
			</div>
		)}

		{refsAnt.length > 0 && (
			<div class="section">
				<h2 class="section-heading">Leyes en las que se basa</h2>
				<ul class="ref-list">
					{refsAnt.map((ref) => (
						<li>
							{ref.texto.replace(/^[,\s]+/, '').replace(/[,\s]+$/, '')}
							{ref.norma && (allIds.has(ref.norma) ? <> <a href={`/leyes/${ref.norma}/`}>{ref.norma}</a></> : <> <span class="ref-id">{ref.norma}</span></>)}
						</li>
					))}
				</ul>
			</div>
		)}

		{refsPost.length > 0 && (
			<div class="section">
				<h2 class="section-heading">Leyes que la modifican</h2>
				<ul class="ref-list">
					{refsPost.map((ref) => (
						<li>
							{ref.texto.replace(/^[,\s]+/, '').replace(/[,\s]+$/, '')}
							{ref.norma && (allIds.has(ref.norma) ? <> <a href={`/leyes/${ref.norma}/`}>{ref.norma}</a></> : <> <span class="ref-id">{ref.norma}</span></>)}
						</li>
					))}
				</ul>
			</div>
		)}
	</div>

	{related.length > 0 && (
		<div class="section" id="related-laws">
			<h2 class="section-heading">Normas relacionadas</h2>
			<ul class="ref-list ref-list-related">
				{related.map((r) => (
					<li><a href={`/leyes/${r.id}/`}>{r.titulo}</a></li>
				))}
			</ul>
		</div>
	)}

	<!-- Follow this law -->
	<div class="follow-card" id="follow-card">
		<div class="follow-icon">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
		</div>
		<div class="follow-content">
			<h2 class="follow-heading">¿Quieres saber cuándo cambia esta ley?</h2>
			<p class="follow-desc">Recibe un aviso por email cada vez que se publique una modificación.</p>
			<form class="follow-form" id="follow-form" data-norm-id={id}>
				<div class="follow-input-row">
					<input
						type="email"
						name="email"
						placeholder="Tu email"
						required
						class="follow-input"
						autocomplete="email"
					/>
					<button type="submit" class="follow-btn">Seguir esta ley</button>
				</div>
			</form>
			<p class="follow-msg" id="follow-msg" style="display: none;"></p>
		</div>
	</div>

	{citizenTags.length > 0 && (
		<div class="citizen-tags">
			{citizenTags.map((tag) => (
				<span class="citizen-tag">{tag}</span>
			))}
		</div>
	)}
	</div>

	<!-- Old links pointed at tabs and article anchors on this page (/leyes/X/#texto,
	     /leyes/X/#articulo-14, ?tab=texto). The text now lives on /texto/: send
	     those there, keeping the anchor. -->
	<script is:inline define:vars={{ textPath: lawTextPath(id!) }}>
		(function() {
			var hash = decodeURIComponent(location.hash.slice(1));
			var tab = new URLSearchParams(location.search).get('tab');
			if (tab === 'texto' || hash === 'texto' ||
				(hash && hash !== 'resumen' && hash !== 'reformas' && !document.getElementById(hash))) {
				location.replace(textPath + (hash && hash !== 'texto' ? '#' + encodeURIComponent(hash) : ''));
			}
		})();
	</script>

	<!-- Follow form handler -->
	<script is:inline define:vars={{ apiBase: import.meta.env.PUBLIC_API_URL ?? "https://api.leyabierta.es" }}>
		(function() {
			var form = document.getElementById('follow-form');
			if (!form) return;

			// Pre-fill email from /alerts/me if the user has a known cookie.
			// One-click follow for returning users — they don't retype email.
			var lbCookie = document.cookie.match(/(?:^|; )lb_token=([^;]+)/);
			if (lbCookie) {
				fetch(apiBase + '/v1/alerts/me?token=' + encodeURIComponent(decodeURIComponent(lbCookie[1])))
					.then(function (r) { return r.json(); })
					.then(function (data) {
						if (data && data.email) {
							var emailInput = form.querySelector('input[name="email"]');
							if (emailInput && !emailInput.value) emailInput.value = data.email;
						}
					})
					.catch(function () {});
			}

			form.addEventListener('submit', function(e) {
				e.preventDefault();
				var emailInput = form.querySelector('input[name="email"]');
				var btn = form.querySelector('button[type="submit"]');
				var msg = document.getElementById('follow-msg');
				var normId = form.dataset.normId;
				var email = emailInput.value.trim();

				if (!email || !normId) return;

				btn.disabled = true;
				btn.textContent = 'Enviando...';
				msg.style.display = 'none';

				fetch(apiBase + '/v1/alerts/follow', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email: email, normId: normId })
				})
				.then(function(res) { return res.json(); })
				.then(function(data) {
					if (data.ok) {
						msg.textContent = 'Te hemos enviado un email de confirmación. Revisa tu bandeja de entrada.';
						msg.className = 'follow-msg success';
						form.style.display = 'none';
					} else {
						msg.textContent = data.error || 'Ocurrió un error. Inténtalo de nuevo.';
						msg.className = 'follow-msg error';
						btn.disabled = false;
						btn.textContent = 'Seguir esta ley';
					}
					msg.style.display = 'block';
				})
				.catch(function() {
					msg.textContent = 'Error de conexión. Inténtalo de nuevo.';
					msg.className = 'follow-msg error';
					msg.style.display = 'block';
					btn.disabled = false;
					btn.textContent = 'Seguir esta ley';
				});
			});
		})();
	</script>

</Base>
