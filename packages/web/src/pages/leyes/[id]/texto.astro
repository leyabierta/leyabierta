---
/**
 * /leyes/[id]/texto/ — the full consolidated text of a law, as published by
 * the BOE, with each article's plain-language summary (AI) right next to it.
 *
 * Not for search engines: the text itself is the BOE's, so this page is
 * `noindex, follow` and stays out of every sitemap. The indexable page is
 * /leyes/[id]/, which carries only our own content and links here.
 *
 * DISABLED BY DEFAULT: only built with `BUILD_TEXT_PAGES=true`. These ~12k
 * pages push the deploy past the Workers Free limit of 20,000 static assets,
 * so for now "texto completo" links go to the BOE instead (see boeUrl). Kept
 * so it can come back as-is on a paid Workers plan.
 */
import { getCollection } from "astro:content";
import { promises as fs } from "node:fs";
import Base from "../../../layouts/Base.astro";
import { bakeArticleSummaries } from "../../../lib/article-summaries.ts";
import {
	BUILD_TEXT_PAGES,
	boeUrl,
	RANK_LABELS,
	STATUS_LABELS,
} from "../../../lib/law-labels.ts";
import { lawBody, renderLawHtml } from "../../../lib/law-text.ts";
import { loadArticleSummaries } from "../../../lib/manifest.ts";
import { composeSeoTitle, SEO_TITLE_MAX, shortLawTitle } from "../../../lib/seo-title.ts";

export async function getStaticPaths() {
	if (!BUILD_TEXT_PAGES) return [];
	const laws = await getCollection("laws");
	return laws.map((entry) => ({
		params: { id: entry.data.identificador },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { id } = Astro.params;
const law = entry.data;

let htmlContent = "";
let summaryCount = 0;
if (entry.body) {
	const raw = await fs.readFile(entry.body, "utf-8");
	const pairs = loadArticleSummaries()?.[id!];
	htmlContent = bakeArticleSummaries(renderLawHtml(lawBody(raw)), pairs);
	summaryCount = pairs?.filter(([, s]) => s).length ?? 0;
}

// noindex, so length is not an SEO ranking concern, but a crawled page still
// shows up in Bing's title-length report — reuse the same short subject as
// the ficha page's <title>, prefixed instead of suffixed.
const TEXTO_PREFIX = "Texto completo — ";
const shortSubject = shortLawTitle(
	{
		id: id!,
		titulo: law.titulo,
		rango: law.rango,
		jurisdiccion: law.jurisdiccion,
		fechaPublicacion: law.fecha_publicacion,
	},
	SEO_TITLE_MAX - TEXTO_PREFIX.length,
);
const textoTitle = composeSeoTitle(`${TEXTO_PREFIX}${shortSubject}`);
---

<Base
	title={textoTitle}
	appendSiteSuffix={false}
	ogTitle={`Texto completo — ${law.titulo}`}
	description={`Texto consolidado de ${law.titulo}, tal como lo publica el BOE, con un resumen en lenguaje sencillo junto a cada artículo.`}
	canonicalUrl={`/leyes/${id}/texto/`}
	noindex
>
	<style>
		.back-link { font-size: 0.8125rem; color: var(--text-muted); }
		.back-link:hover { color: var(--text-secondary); }

		.law-header { margin: 0.75rem 0 0.5rem; }
		.law-kicker {
			font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
			font-size: 0.6875rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--text-muted);
			margin-bottom: 0.375rem;
		}
		.law-title {
			font-family: var(--font-serif);
			font-size: 1.375rem;
			font-weight: 700;
			line-height: 1.35;
			letter-spacing: -0.01em;
		}

		.text-intro {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem 1.25rem;
			padding: 1rem 1.25rem;
			margin: 1rem 0 1.5rem;
			background: var(--accent-faint);
			border: 1px solid var(--border);
			border-radius: 10px;
			font-size: 0.875rem;
			color: var(--text-secondary);
			line-height: 1.55;
		}
		.text-intro p { margin: 0; flex: 1 1 22rem; }
		.text-intro-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
		.btn-primary, .btn-outline {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			padding: 0.5rem 0.875rem;
			border-radius: 6px;
			font-size: 0.8125rem;
			font-weight: 600;
			white-space: nowrap;
		}
		.btn-primary { background: var(--accent); color: #fff; border: 1.5px solid var(--accent); }
		.btn-primary:hover { color: #fff; text-decoration: underline; }
		.btn-outline { background: var(--surface); color: var(--text-secondary); border: 1.5px solid var(--border); }
		.btn-outline:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

		/* ── Text layout with TOC ── */
		.texto-layout {
			display: flex;
			gap: 0;
			align-items: flex-start;
			/* Break out of container to use full viewport width */
			margin-left: calc(-50vw + 50%);
			margin-right: calc(-50vw + 50%);
			padding-left: max(1.25rem, calc(50vw - 36rem));
			padding-right: max(1.25rem, calc(50vw - 36rem));
		}
		.texto-layout .law-content { flex: 1; min-width: 0; max-width: 52rem; }

		.law-content {
			font-family: var(--font-serif);
			line-height: 1.8;
			font-size: 0.9375rem;
			overflow-wrap: break-word;
			word-break: break-word;
		}
		.law-content :global(h2) { font-size: 1.125rem; font-weight: 700; margin: 2.5rem 0 0.75rem; text-align: center; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text); padding: 0.5rem 0; border-top: 2px solid var(--accent); border-bottom: 1px solid var(--border-light); }
		.law-content :global(h3) { font-size: 1rem; font-weight: 700; color: var(--accent); margin: 2rem 0 0.5rem; font-family: var(--font-sans); text-align: center; text-transform: uppercase; letter-spacing: 0.03em; }
		.law-content :global(h4) { font-size: 0.875rem; font-weight: 600; margin: 1.5rem 0 0.5rem; text-align: center; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.02em; }
		.law-content :global(h5) { font-size: 0.8125rem; font-weight: 600; margin: 1.25rem 0 0.375rem; text-align: center; color: var(--text-muted); font-style: italic; }
		.law-content :global(h6) { font-size: 0.9375rem; font-weight: 700; margin: 1.5rem 0 0.5rem; color: var(--text); padding-bottom: 0.25rem; border-bottom: 1px solid var(--border-light); }
		.law-content :global(p) { margin-bottom: 0.75rem; }
		:global(.law-rubric) { text-align: center; font-weight: 700; color: var(--text); margin-top: -0.25rem; font-family: var(--font-sans); font-size: 0.875rem; }
		/* Offset for scroll-to with sticky header */
		.law-content :global([id]) { scroll-margin-top: 4rem; }
		.law-content :global(hr) { border: none; border-top: 1px solid var(--border-light); margin: 1.5rem 0 0.75rem; }
		.law-content :global(:target) { background: var(--accent-faint); }

		/* ── Plain-language summary next to each article (AI) ──
		   Warm cream = the system speaking in a human voice (DESIGN.md), set
		   apart from the legal text it explains, which stays primary. */
		.law-content :global(.article-summary) {
			margin: 0.25rem 0 1rem;
			padding: 0.625rem 0.875rem;
			background: var(--tierra-warm);
			border: 1px solid var(--tierra-deep);
			border-radius: 10px;
			font-family: var(--font-sans);
		}
		.law-content :global(.article-summary-label) {
			margin: 0 0 0.25rem;
			font-family: var(--font-mono, "JetBrains Mono", ui-monospace, monospace);
			font-size: 0.6875rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--text-muted);
			line-height: 1.5;
		}
		.law-content :global(.article-summary-label a) { color: var(--text-muted); text-decoration: underline; }
		.law-content :global(.article-summary-label a:hover) { color: var(--accent); }
		.law-content :global(.article-summary-text) {
			margin: 0;
			font-size: 0.875rem;
			color: var(--text-secondary);
			line-height: 1.6;
		}

		.toc {
			position: sticky;
			top: 4rem;
			width: 240px;
			flex-shrink: 0;
			max-height: calc(100vh - 5rem);
			overflow-y: auto;
			font-size: 0.8125rem;
			margin-right: 1.5rem;
			padding-right: 1rem;
			border-right: 1px solid var(--border-light);
			scrollbar-width: thin;
			scrollbar-color: var(--border-light) transparent;
		}
		.toc-header {
			font-size: 0.6875rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--text-muted);
			margin-bottom: 0.5rem;
			padding-bottom: 0.375rem;
			border-bottom: 1px solid var(--border-light);
		}
		.toc-list :global(.toc-item) {
			display: block;
			padding: 0.2rem 0.375rem;
			color: var(--text-muted);
			text-decoration: none;
			border-radius: 3px;
			line-height: 1.35;
			margin-bottom: 0.0625rem;
			transition: color 0.1s, background 0.1s;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.toc-list :global(.toc-item:hover) { color: var(--accent); background: var(--accent-faint); text-decoration: none; }
		.toc-list :global(.toc-item.toc-active) { color: var(--accent); font-weight: 600; background: var(--accent-bg); }
		.toc-list :global(.toc-level-2) { font-weight: 600; color: var(--text); margin-top: 0.625rem; }
		.toc-list :global(.toc-level-3) { padding-left: 0.625rem; margin-top: 0.375rem; font-weight: 600; color: var(--text-secondary); }
		.toc-list :global(.toc-level-4) { padding-left: 1.125rem; }
		.toc-list :global(.toc-level-5) { padding-left: 1.5rem; }
		.toc-list :global(.toc-level-6) { padding-left: 1.875rem; color: var(--text-muted); }

		.text-footer {
			margin: 2.5rem 0 0;
			padding-top: 1.25rem;
			border-top: 1px solid var(--border-light);
			font-size: 0.875rem;
			color: var(--text-muted);
		}

		@media (max-width: 960px) {
			.texto-layout { margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
			.toc { display: none; }
		}
		@media (max-width: 640px) {
			.law-content { font-size: 0.875rem; }
			.text-intro { padding: 0.875rem 1rem; }
		}
	</style>

	<a href={`/leyes/${id}/`} class="back-link">&larr; Resumen de la ley</a>

	<div class="law-header">
		<div class="law-kicker">Texto completo · {RANK_LABELS[law.rango] ?? law.rango} · {STATUS_LABELS[law.estado] ?? law.estado}</div>
		<h1 class="law-title">{law.titulo}</h1>
	</div>

	<div class="text-intro">
		<p>
			Texto consolidado tal como lo publica el BOE, que es la versión oficial.
			{summaryCount > 0 && <> Junto a los artículos que lo tienen verás un resumen en lenguaje sencillo, generado con IA, que no es asesoramiento jurídico (<a href="/sobre/#resumenes-ia">cómo se hacen</a>).</>}
		</p>
		<div class="text-intro-actions">
			<a href={`/leyes/${id}/`} class="btn-primary">Ver el resumen de la ley</a>
			<a href={boeUrl(law.identificador)} target="_blank" rel="noopener" class="btn-outline">Ver en el BOE</a>
		</div>
	</div>

	<div class="texto-layout">
		<nav class="toc" id="toc" aria-label="Índice del texto">
			<div class="toc-header">Índice</div>
			<div class="toc-list" id="toc-list"></div>
		</nav>
		<div class="law-content" set:html={htmlContent} />
	</div>

	<p class="text-footer">
		Fuente: Agencia Estatal BOE (<a href={boeUrl(law.identificador)} target="_blank" rel="noopener">texto oficial</a>).
		<a href={`/leyes/${id}/`}>Volver al resumen de la ley</a>.
	</p>

	<!-- Style rubric paragraphs (subtitles after structural headings) -->
	<script is:inline>
	(function() {
		var lawContent = document.querySelector('.law-content');
		if (!lawContent) return;
		var headings = lawContent.querySelectorAll('h2, h3, h4');
		headings.forEach(function(h) {
			var next = h.nextElementSibling;
			while (next && next.tagName === 'HR') { next = next.nextElementSibling; }
			if (!next || next.tagName !== 'P') return;
			var text = next.textContent.trim();
			if (text.length > 0 && text.length < 120 && !text.endsWith('.') && !text.includes('. ')) {
				next.classList.add('law-rubric');
			}
		});
	})();
	</script>

	<!-- Build table of contents from headings in law content -->
	<script is:inline>
	(function() {
		var tocList = document.getElementById('toc-list');
		var lawContent = document.querySelector('.law-content');
		if (!tocList || !lawContent) return;

		var headings = lawContent.querySelectorAll('h2, h3, h4, h5, h6');
		if (headings.length === 0) {
			document.getElementById('toc')?.remove();
			return;
		}

		var frag = document.createDocumentFragment();
		var tocHeadings = [];
		headings.forEach(function(h, i) {
			if (!h.id) { h.id = 'sec-' + i; }
			var level = parseInt(h.tagName.charAt(1));
			var text = h.textContent.replace(/\s+/g, ' ').trim();
			if (text.length < 2) return;

			// For articles (h5/h6), shorten to just "Art. N"
			var label = text;
			if (level >= 5) {
				var artMatch = text.match(/^Art[ií]culo\s+(\d+[-\d]*)/i);
				if (artMatch) {
					label = 'Art. ' + artMatch[1];
				}
			}

			tocHeadings.push(h);
			var link = document.createElement('a');
			link.href = '#' + h.id;
			link.className = 'toc-item toc-level-' + level;
			link.textContent = label;
			link.title = text;
			link.addEventListener('click', function(e) {
				e.preventDefault();
				var top = h.getBoundingClientRect().top + window.scrollY - 80;
				window.scrollTo({ top: top, behavior: 'smooth' });
				history.replaceState(null, '', '#' + h.id);
			});
			frag.appendChild(link);
		});

		if (tocHeadings.length < 2) {
			document.getElementById('toc')?.remove();
			return;
		}

		tocList.appendChild(frag);

		var tocItems = tocList.querySelectorAll('.toc-item');
		var ticking = false;
		function updateTocHighlight() {
			var scrollTop = window.scrollY + 100;
			var activeIdx = 0;
			for (var i = 0; i < tocHeadings.length; i++) {
				if (tocHeadings[i].offsetTop <= scrollTop) {
					activeIdx = i;
				} else {
					break;
				}
			}
			tocItems.forEach(function(item, j) {
				item.classList.toggle('toc-active', j === activeIdx);
			});
			var activeItem = tocItems[activeIdx];
			if (activeItem) {
				var tocEl = document.getElementById('toc');
				if (tocEl) {
					var itemTop = activeItem.offsetTop - tocEl.offsetTop;
					var tocScroll = tocEl.scrollTop;
					var tocHeight = tocEl.clientHeight;
					if (itemTop < tocScroll + 40 || itemTop > tocScroll + tocHeight - 40) {
						tocEl.scrollTop = itemTop - tocHeight / 3;
					}
				}
			}
			ticking = false;
		}
		window.addEventListener('scroll', function() {
			if (!ticking) {
				requestAnimationFrame(updateTocHighlight);
				ticking = true;
			}
		}, { passive: true });
		updateTocHighlight();
	})();
	</script>
</Base>
