---
// ── "Explora por tema" — the home's entry point into the topic hubs ─────────
//
// Until this block existed the hubs had zero inbound internal links: only the
// sitemap knew about them. Meanwhile the home was the landing page for the very
// queries they were built for ("ley de empleo", 22 impressions at position 73;
// "leyes laborales españa", 12 at position 94), because Google had nothing
// better to map them to.
//
// The list comes from src/components/topic-hubs.ts so the home, the law pages
// and the sitemap cannot disagree about which hubs exist.
import { TOPIC_HUBS } from "./topic-hubs";
---

<section class="la-section animate-on-scroll">
	<div class="section-header">
		<div>
			<div class="hero-eyebrow">Legislación por materia</div>
			<h2>Explora por tema</h2>
		</div>
		<a href="/mi-situacion/" class="see-all">Ver todos los temas &rarr;</a>
	</div>

	<ul class="hub-grid">
		{TOPIC_HUBS.map(hub => (
			<li class="hub-card">
				<a href={hub.path}>
					<span class="hub-label">{hub.label}</span>
					<span class="hub-blurb">{hub.blurb}</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.hub-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 1rem;
	}
	.hub-card a {
		display: block;
		height: 100%;
		padding: 1.25rem 1.375rem;
		border: 1px solid var(--border-light);
		border-radius: 0.375rem;
		background: var(--surface);
		transition: border-color 0.15s ease;
	}
	.hub-card a:hover {
		border-color: var(--accent);
		text-decoration: none;
	}
	.hub-label {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--text);
		margin-bottom: 0.375rem;
	}
	.hub-card a:hover .hub-label { color: var(--accent); }
	.hub-blurb {
		display: block;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--text-secondary);
	}
</style>
