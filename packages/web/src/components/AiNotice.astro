---
/**
 * Static "generated with AI" notice for pages that list AI headlines and
 * summaries (reform lists). Server-rendered, so it is there without JS.
 * Reusable on any page that shows AI summaries: pass `text` to adapt it.
 */
import { AI_SUMMARIES_EXPLAINER_HREF } from "../lib/article-summaries.ts";

interface Props {
	text?: string;
}

const {
	text = "Los titulares y resúmenes de estos cambios están generados con inteligencia artificial a partir del texto oficial y pueden contener errores. No son asesoramiento jurídico: lo que tiene validez es lo publicado en el BOE, que enlazamos en la página de cada cambio.",
} = Astro.props;
---

<p class="ai-notice">
	{text}{" "}
	<a href={AI_SUMMARIES_EXPLAINER_HREF}>Cómo los hacemos</a>.
</p>

<style>
	.ai-notice {
		font-size: 0.8125rem;
		color: var(--text-secondary);
		line-height: 1.55;
		margin: 0.75rem 0 0;
		padding: 0.5rem 0.75rem;
		background: var(--tierra-warm);
		border: 1px solid var(--tierra-deep);
		border-radius: 8px;
	}
	.ai-notice a {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
