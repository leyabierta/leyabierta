# === Required in production ===

# HMAC secret for email confirmation tokens (generate: openssl rand -hex 32)
ALERTS_SECRET=

# Resend email service (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_AUDIENCE_ID=

# === Optional (have defaults) ===

# Database path (default: ./data/leyabierta.db)
DB_PATH=./data/leyabierta.db

# Path to leyes repository (default: ../leyes)
REPO_PATH=../leyes

# Server port (default: 3000)
PORT=3000

# Public site URL (default: https://leyabierta.es)
SITE_URL=https://leyabierta.es

# From email (default: Ley Abierta <alertas@leyabierta.es>)
FROM_EMAIL=Ley Abierta <alertas@leyabierta.es>

# CORS origins, comma-separated (default: leyabierta.es + localhost)
CORS_ORIGINS=https://leyabierta.es,https://www.leyabierta.es,http://localhost:4321

# Environment (default: development)
NODE_ENV=development

# === AI (OpenRouter) ===
#
# Required. Single OpenRouter key used by every AI path:
#   - RAG embeddings: qwen/qwen3-embedding-8b (4096 dims)
#   - RAG query analyzer (+ auxiliary calls): OPENROUTER_LLM_MODEL
#   - RAG answer synthesis: OPENROUTER_SYNTHESIS_MODEL
#   - RAG reranker: OPENROUTER_RERANK_LLM_MODEL (LLM rerank, ZDR-compatible)
#   - Generated content (reform summaries, citizen tags/summaries, omnibus
#     topics, lazy per-article summaries): CONTENT_LLM_MODEL
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

# Model for generated citizen content (any OpenRouter chat model with
# JSON-schema structured outputs). Default: google/gemini-2.5-flash-lite
# CONTENT_LLM_MODEL=google/gemini-2.5-flash-lite
#
# Per-run caps for the daily gap-filling generators (defaults shown)
# REFORM_SUMMARIES_WEEKS=26
# REFORM_SUMMARIES_LIMIT=200
# CITIZEN_TAGS_MAX_PER_RUN=100

# Legacy: api.nan.builders (cancelled 2026-08). Only read by the explicit
# LLM_BACKEND=nan / RERANK_BACKEND=qwen-llm opt-ins and research scripts.
# NAN_API_KEY=

# Optional override: low-confidence early-return threshold for retrieval.
# Default 0.40 (effectively off — bestScore is not informative about
# correctness with the qwen+qwen+qwen stack; calibration in Phase 5 showed
# hit/miss distributions overlap, separation ~0.04). Used only to catch
# catastrophic embedding failures.
# LOW_CONFIDENCE_THRESHOLD=0.40

# === Pluggable LLM / rerank backends (feature flags) ===
#
# LLM_BACKEND: routes query-analyzer, synthesis and post-synthesis.
#   "openrouter" — default; OPENROUTER_LLM_MODEL via OpenRouter
#   "nan"        — legacy opt-in (qwen3.6 via api.nan.builders); ignored with
#                  a warning unless NAN_API_KEY is set
# LLM_BACKEND=openrouter
#
# RERANK_BACKEND: routes the article reranker.
#   "llm"       — default; listwise LLM rerank via OpenRouter
#                 (OPENROUTER_RERANK_LLM_MODEL). Works under Zero Data Retention.
#   "none"      — keep the fused (RRF + boosts) order, no extra call
#   "cohere-or" — opt-in; Cohere Rerank via OpenRouter. Cohere has no ZDR
#                 endpoint: on a ZDR account every call 404s (fused order).
#   "qwen-llm"  — legacy opt-in (qwen3.6 LLM rerank via NaN); ignored with a
#                 warning unless NAN_API_KEY is set
# RERANK_BACKEND=llm
#
# OPENROUTER_RERANK_LLM_MODEL: chat model when RERANK_BACKEND=llm
# OPENROUTER_RERANK_LLM_MODEL=google/gemini-2.5-flash-lite
#
# OPENROUTER_LLM_MODEL: analyzer + auxiliary calls when LLM_BACKEND=openrouter
# OPENROUTER_LLM_MODEL=google/gemini-2.5-flash-lite
#
# OPENROUTER_SYNTHESIS_MODEL: model that writes the answer (JSON + streaming)
# OPENROUTER_SYNTHESIS_MODEL=openai/gpt-6-luna
#
# OPENROUTER_SYNTHESIS_REASONING: minimal | low | medium | high | none
# Default: minimal for openai/* models, unset (provider default) otherwise.
# OPENROUTER_SYNTHESIS_REASONING=minimal
#
# OPENROUTER_RERANK_MODEL: rerank model when RERANK_BACKEND=cohere-or
# OPENROUTER_RERANK_MODEL=cohere/rerank-4-fast
